# Server Port
PORT=3000

# Discogs API Configuration
# Optional: Get a personal access token at https://www.discogs.com/settings/developers
# You can also enter this directly in the Web UI!
DISCOGS_API_TOKEN=

# Firebase Web App Configuration (optional on server, can be configured in UI)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
